  <property name="styleSheet">
   <string>QMainWindow, QWidget#centralwidget, QScrollArea, QWidget[objectName^="scrollAreaContents"] { background: #f3f6fb; }
QWidget { font-size: 10pt; color: #1f2d3d; }
QFrame#frameMenu { background: #0f2d52; }
QFrame#frameMenu QLabel { color: #ffffff; }
QLabel[class="appTitle"] { font-size: 16pt; font-weight: bold; color: #ffffff; }
QLabel[class="appSubtitle"] { font-size: 9pt; color: #b8c7dc; }
QPushButton[class="menu"] { text-align: left; padding: 10px 12px; border: none; border-radius: 6px; color: #dce6f3; background: transparent; }
QPushButton[class="menu"]:hover { background: #1b416f; }
QPushButton[class="menu"]:checked { background: #1f6feb; color: #ffffff; font-weight: bold; }
QLabel[class="pageTitle"] { font-size: 20pt; font-weight: bold; color: #13355f; }
QLabel[class="pageSubtitle"] { color: #5b6b7f; }
QFrame[class="kpi"] { background: #ffffff; border: 1px solid #dfe5ee; border-radius: 8px; }
QLabel[class="kpiTitle"] { font-weight: bold; color: #13355f; border: none; }
QLabel[class="kpiValue"] { font-size: 16pt; font-weight: bold; color: #13355f; border: none; }
QLabel[class="kpiNote"] { font-size: 9pt; color: #5b6b7f; border: none; }
QLabel[class="info"] { background: #e8f0fb; border-radius: 6px; padding: 8px; color: #24476f; }
QLabel[class="warning"] { color: #9a5b00; }
QGroupBox { background: #ffffff; border: 1px solid #dfe5ee; border-radius: 8px; margin-top: 14px; padding: 10px; font-weight: bold; color: #13355f; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; }
QPushButton { padding: 7px 14px; border: 1px solid #c9d3e0; border-radius: 6px; background: #ffffff; }
QPushButton:hover { background: #eef3fa; }
QPushButton[class="primary"] { background: #1f6feb; color: #ffffff; border: none; font-weight: bold; }
QPushButton[class="primary"]:hover { background: #1a5fd0; }
QPushButton:disabled { background: #d5dbe4; color: #7d8794; }
QTableWidget { background: #ffffff; gridline-color: #e6ebf2; alternate-background-color: #f7f9fc; }
QHeaderView::section { background: #eef2f7; padding: 4px; border: none; font-weight: bold; }
QComboBox, QDateEdit, QLineEdit, QSpinBox { padding: 4px; border: 1px solid #c9d3e0; border-radius: 4px; background: #ffffff; }
QTextBrowser, QTextEdit { background: #ffffff; color: #1f2d3d; border: 1px solid #dfe5ee; border-radius: 6px; }
QComboBox { color: #1f2d3d; }
QComboBox QAbstractItemView { background: #ffffff; color: #1f2d3d; border: 1px solid #c9d3e0; selection-background-color: #1f6feb; selection-color: #ffffff; outline: 0; }
QDateEdit, QSpinBox, QLineEdit { color: #1f2d3d; }
QCalendarWidget QWidget { background: #ffffff; color: #1f2d3d; alternate-background-color: #eef3fa; }
QCalendarWidget QToolButton { color: #13355f; background: #eef3fa; border: none; padding: 4px; }
QCalendarWidget QAbstractItemView:enabled { color: #1f2d3d; selection-background-color: #1f6feb; selection-color: #ffffff; }
QCalendarWidget QAbstractItemView:disabled { color: #b0b8c4; }
QTableWidget, QTableView { color: #1f2d3d; selection-background-color: #1f6feb; selection-color: #ffffff; }
QTableCornerButton::section { background: #eef2f7; border: none; }
QToolTip { background: #ffffff; color: #1f2d3d; border: 1px solid #c9d3e0; }
QMessageBox, QFileDialog { background: #ffffff; }
QMessageBox QLabel { color: #1f2d3d; }
QStatusBar { background: #f3f6fb; color: #1f2d3d; }
</string>
